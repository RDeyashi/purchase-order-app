{
  "_version": "1.89.0",
  "sap.app": {
    "id": "com.po.app.polist",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.32.0",
      "toolsId": "78b40b3c-0659-45d0-b68d-2114351a33ab"
    },
    "dataSources": {
      "mainService": {
        "uri": "/api/po/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "PurchaseOrder-display": {
          "semanticObject": "PurchaseOrder",
          "action": "display",
          "title": "{{PurchaseOrder-display.flpTitle}}",
          "subTitle": "{{PurchaseOrder-display.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://purchase-order",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.po.app.polist.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PurchaseOrdersList",
          "target": "PurchaseOrdersList"
        },
        {
          "pattern": "PurchaseOrders({key}):?query:",
          "name": "PurchaseOrdersObjectPage",
          "target": "PurchaseOrdersObjectPage"
        }
      ],
      "targets": {
    "PurchaseOrdersList": {
        "type": "Component",
        "id": "PurchaseOrdersList",
        "name": "sap.fe.templates.ListReport",
        "options": {
            "settings": {
                "contextPath": "/PurchaseOrders",
                "variantManagement": "Page",
                "initialLoad": true,
                "navigation": {
                    "PurchaseOrders": {
                        "detail": {
                            "route": "PurchaseOrdersObjectPage"
                        }
                    }
                },
                "controlConfiguration": {
                    "@com.sap.vocabularies.UI.v1.LineItem": {
                        "tableSettings": {
                            "type": "AnalyticalTable",
                            "selectionMode": "Multi"
                        }
                    }
                }
            }
        }
    },
    "PurchaseOrdersObjectPage": {
        "type": "Component",
        "id": "PurchaseOrdersObjectPage",
        "name": "sap.fe.templates.ObjectPage",
        "options": {
            "settings": {
                "editableHeaderContent": false,
                "contextPath": "/PurchaseOrders",
                "initialLoad": true,
                "controlConfiguration": {
                    "items/@com.sap.vocabularies.UI.v1.LineItem": {
                        "tableSettings": {
                            "type": "AnalyticalTable"
                        }
                    },
                    "statusHistory/@com.sap.vocabularies.UI.v1.LineItem": {
                        "tableSettings": {
                            "type": "AnalyticalTable"
                        }
                    }
                }
            }
        }
    }
}
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}