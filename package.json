{
  "name": "purchase-order-app",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-po-list": "cds watch --open com.po.app.polist/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy purchase-order-app --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "restrict_all_services": true,
        "users": {
          "viewer.user": {
            "password": "pass",
            "roles": [
              "PO_Viewer"
            ]
          },
          "creator.user": {
            "password": "pass",
            "roles": [
              "PO_Creator"
            ]
          },
          "approver.user": {
            "password": "pass",
            "roles": [
              "PO_Approver"
            ]
          },
          "admin.user": {
            "password": "pass",
            "roles": [
              "PO_Admin"
            ]
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/po-list"
  ]
}
